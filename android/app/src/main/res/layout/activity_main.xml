<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050403">

    <global.nscb.aegis.GlHudView
        android:id="@+id/gl_hud"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66050403" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.28"
                android:text="AEGIS"
                android:textColor="#F7F2E6"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_live"
                android:fontFamily="monospace"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="SHIELD"
                android:textColor="#F0A202"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:text="IDLE"
            android:textColor="#F0A202"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/hud_panel"
            android:fontFamily="monospace"
            android:padding="14dp"
            android:text="ready"
            android:textColor="#E8E0D0"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/current"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="middle"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:text="-"
            android:textColor="#7A7366"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_scan"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/btn_amber"
                android:text="Deep scan"
                android:textAllCaps="false"
                android:textColor="#1A1204"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_stop"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/btn_ghost"
                android:text="Stop"
                android:textAllCaps="false"
                android:textColor="#F4F0E4" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_signal"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/btn_ghost"
                android:text="Signal"
                android:textAllCaps="false"
                android:textColor="#F4F0E4"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_sms"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/btn_ghost"
                android:text="SMS"
                android:textAllCaps="false"
                android:textColor="#F4F0E4"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_email"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/btn_ghost"
                android:text="Email"
                android:textAllCaps="false"
                android:textColor="#F4F0E4"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_apps"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/btn_ghost"
                android:text="Apps"
                android:textAllCaps="false"
                android:textColor="#F0A202" />

            <Button
                android:id="@+id/btn_defs"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/btn_ghost"
                android:text="Defs"
                android:textAllCaps="false"
                android:textColor="#3ECF8E" />

            <Button
                android:id="@+id/btn_alerts"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/btn_ghost"
                android:text="Alerts"
                android:textAllCaps="false"
                android:textColor="#E8B84A" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_quarantine"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/btn_ghost"
                android:text="Quarantine hits"
                android:textAllCaps="false"
                android:textColor="#FF5A4A" />

            <Button
                android:id="@+id/btn_vault"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/btn_ghost"
                android:text="Open vault"
                android:textAllCaps="false"
                android:textColor="#C4B8A0" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:letterSpacing="0.15"
            android:text="OPERATIONS LOG"
            android:textColor="#6E6758"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/findings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/hud_panel"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:minHeight="160dp"
                android:padding="14dp"
                android:text="NSCB Global Technologies\nAlways-on monitor starts with the app (low power).\nDeep scan / apps / defs / alerts / quarantine below."
                android:textColor="#EDE6D9"
                android:textSize="12sp" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
