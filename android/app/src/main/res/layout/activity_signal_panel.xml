<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050403">

    <View
        android:id="@+id/sp_pulse"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_gravity="top"
        android:background="#F0A202"
        android:alpha="0.5" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/sp_back"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/btn_ghost"
                    android:text="Back"
                    android:textAllCaps="false"
                    android:textColor="#F4F0E4" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:letterSpacing="0.15"
                    android:text="TOWER / DEAD-ZONE"
                    android:textColor="#F7F2E6"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/sp_export"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/btn_amber"
                    android:text="Export"
                    android:textAllCaps="false"
                    android:textColor="#1A1204"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/sp_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:text="SIGNAL PANEL"
                android:textColor="#F0A202"
                android:textSize="12sp" />

            <Button
                android:id="@+id/sp_drive"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/btn_ghost"
                android:text="Drive anim ON"
                android:textAllCaps="false"
                android:textColor="#F4F0E4" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="MAP (you + dead zones)"
                android:textColor="#8F8774"
                android:textSize="11sp" />

            <org.osmdroid.views.MapView
                android:id="@+id/sp_map"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_marginTop="4dp"
                android:background="#111111"
                android:minHeight="280dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="LIVE CELL"
                android:textColor="#8F8774"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/sp_live"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/hud_panel"
                android:fontFamily="monospace"
                android:padding="10dp"
                android:text="—"
                android:textColor="#C8B89A"
                android:textSize="11sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="DEAD-ZONE EVENTS"
                android:textColor="#E0452A"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/sp_dead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/hud_panel"
                android:fontFamily="monospace"
                android:minHeight="80dp"
                android:padding="10dp"
                android:text="No dead-zone events yet."
                android:textColor="#E8B84A"
                android:textSize="11sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="TOWER EVENT HISTORY"
                android:textColor="#8F8774"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/sp_tower"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/hud_panel"
                android:fontFamily="monospace"
                android:minHeight="100dp"
                android:padding="10dp"
                android:text="—"
                android:textColor="#C8B89A"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
